{
  // Type checking for the TaskBoard app: the Node API (run as .ts by Node 24's type stripping)
  // and the React UI (bundled by Vite). Neither is compiled by tsc, so noEmit.
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    // Node runs .ts files directly only when imports name the .ts file and the code uses
    // syntax that can simply be erased (no enums, no parameter properties).
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": [
    "app/**/*.ts",
    "app/**/*.tsx",
    "vite.config.ts",
    "cypress.config.ts",
    "cypress/support/modules.d.ts"
  ]
}
