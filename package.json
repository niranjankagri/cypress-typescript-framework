{
  "name": "cypress-typescript-framework",
  "version": "1.0.0",
  "private": true,
  "description": "Cypress + TypeScript test framework: E2E, API and component tests for the TaskBoard demo app (React + Node) that lives in this repo.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "vite build",
    "start": "node app/server/server.ts",
    "dev": "vite",
    "test:app": "node --test \"app/server/*.test.ts\"",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p cypress/tsconfig.json"
  },
  "author": "Niranjan Kumar Agri",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "cypress": "16.2.0",
    "cypress-mochawesome-reporter": "5.0.0",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-cypress": "7.0.2",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "start-server-and-test": "3.0.13",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "zod": "4.6.7"
  }
}
